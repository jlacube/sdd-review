{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "bench/**/*.ts",
    "spikes/parse/**/*.ts",
    "spikes/evidence/**/*.ts",
    "scripts/study/**/*.ts",
    "test/fixtures/study/**/*.ts",
    "spikes/ui/*.ts"
  ]
}
