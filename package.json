{
  "name": "sdd-review",
  "version": "0.1.0",
  "description": "Review assistant for large AI-generated changes",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sdd-review": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "runtime/"
  ],
  "scripts": {
    "build": "node scripts/generate-types.mjs && tsc -p tsconfig.json",
    "lint": "npm run lint:ts && npm run lint:py && npm run lint:cs",
    "lint:ts": "eslint . && prettier --check .",
    "lint:py": "ruff check runtime/python && ruff format --check runtime/python",
    "lint:cs": "dotnet format runtime/dotnet/Placeholder.csproj --verify-no-changes",
    "licence-check": "node scripts/licence-check.mjs",
    "audit": "npm audit --audit-level=high",
    "secret-scan": "node scripts/secret-scan.mjs",
    "test": "vitest run",
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:browser": "node scripts/acceptance.mjs --browser"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "json-schema-to-typescript": "16.0.0",
    "license-checker-rseidelsohn": "5.0.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "vite": "7.3.8"
  }
}
